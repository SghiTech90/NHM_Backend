# Copy to .env locally. On Railway, set these in the service Variables tab.

# Server (Railway sets PORT automatically)
PORT=5000
NODE_ENV=production

# Frontend origins allowed to call this API (comma-separated)
ALLOWED_ORIGINS=https://nhm.wispune.com,http://localhost:5173

# Legacy single-origin override (optional if ALLOWED_ORIGINS is set)
# CLIENT_URL=https://nhm.wispune.com

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# SQL Server (must be reachable from Railway — allow Railway egress / use public endpoint)
DB_SERVER=your-sql-host
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=your-password
DB_ENCRYPT=true
DB_TRUST_CERT=true
# DB_INSTANCE=optional-named-instance
